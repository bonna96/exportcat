# ── Server ──
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ── PostgreSQL (Prisma) ──
DATABASE_URL=postgresql://postgres:password@localhost:5432/exportcat?schema=public

# ── Supabase Authentication ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret-at-least-32-characters

# ── OpenSearch ──
OPENSEARCH_NODE=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_PREFIX=exportcat

# ── Email (Nodemailer SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ExportCat <noreply@exportcat.com>"

# ── Image Pipeline ──
UPLOAD_DIR=public/uploads
MAX_IMAGE_SIZE_MB=10

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SEARCH_RATE_LIMIT_MAX=30
ENQUIRY_RATE_LIMIT_MAX=5

# ── Supported Locales ──
DEFAULT_LOCALE=en-gb
SUPPORTED_LOCALES=en-gb,de-de,fr-fr,es-es,ja-jp
