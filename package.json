{
  "name": "exportcat",
  "version": "1.0.0",
  "description": "ExportCat — B2B Export Product Catalogue with IR & SEO Engine",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma db push --force-reset && node prisma/seed.js",
    "css:build": "npx tailwindcss -i ./src/styles/tailwind.css -o ./public/css/styles.css --minify",
    "css:watch": "npx tailwindcss -i ./src/styles/tailwind.css -o ./public/css/styles.css --watch",
    "test": "jest --detectOpenHandles",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^2.7.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.45.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-static": "^0.436.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
