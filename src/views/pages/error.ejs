<div class="container" style="padding-top: 5rem; padding-bottom: 6rem; text-align: center;">
  <div style="max-width: 520px; margin: 0 auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 3rem 2rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);">
    <div style="font-size: 4rem; font-weight: 900; color: #1e3a8a; line-height: 1; margin-bottom: 1rem;">
      <%= typeof statusCode !== 'undefined' ? statusCode : 404 %>
    </div>
    <h1 style="font-size: 1.5rem; margin-bottom: 0.75rem;">
      <%= typeof title !== 'undefined' ? title : 'Page Not Found' %>
    </h1>
    <p style="color: #64748b; margin-bottom: 2rem;">
      <%= typeof message !== 'undefined' ? message : 'The requested catalogue resource could not be found or has moved.' %>
    </p>

    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
      <a href="/en-gb" class="btn btn-primary">
        <i data-lucide="home"></i> Return to Catalogue
      </a>
      <a href="/en-gb/search" class="btn btn-outline">
        <i data-lucide="search"></i> Search Products
      </a>
    </div>
  </div>
</div>
