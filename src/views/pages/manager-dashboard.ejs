<div class="container" style="padding-top: 2.5rem; padding-bottom: 5rem;">
  <div class="dashboard-header">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <h1>Catalogue Manager Dashboard</h1>
        <span class="role-tag role-MANAGER">MANAGER PORTAL</span>
      </div>
      <p style="margin-top: 0.25rem;">Create, update, and publish export lots with tiered FOB pricing and technical specifications.</p>
    </div>
    <div style="display: flex; gap: 0.75rem;">
      <button class="btn btn-primary" onclick="document.getElementById('new-product-modal').style.display='flex'">
        <i data-lucide="plus-circle"></i> Add New Product
      </button>
      <a href="/logout" class="btn btn-outline btn-sm">
        <i data-lucide="log-out"></i> Sign Out
      </a>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-card-title">TOTAL CATALOGUE PRODUCTS</div>
      <div class="stat-card-value"><%= stats ? stats.total : products.length %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card-title">PUBLISHED & INDEXED</div>
      <div class="stat-card-value" style="color: #059669;"><%= stats ? stats.published : 0 %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card-title">DRAFT / PENDING REVIEW</div>
      <div class="stat-card-value" style="color: #d97706;"><%= stats ? stats.draft : 0 %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card-title">BUYER RFQ ENQUIRIES</div>
      <div class="stat-card-value" style="color: #2563eb;"><%= stats ? stats.enquiries : 0 %></div>
    </div>
  </div>

  <!-- Products Table -->
  <div class="data-table-wrap">
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
      <h3>Catalogue Items (<%= products ? products.length : 0 %>)</h3>
      <span style="font-size: 0.8125rem; color: #64748b;">Syncs in real-time with OpenSearch & PostgreSQL</span>
    </div>
    <table class="data-table">
      <thead>
        <tr>
          <th>Product Name</th>
          <th>Category</th>
          <th>SKU / HS Code</th>
          <th>MOQ</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (products && products.length > 0) { %>
          <% products.forEach(function(p) { %>
            <tr>
              <td>
                <strong><a href="/en-gb/products/<%= p.slug %>" target="_blank" style="color: #1e3a8a;"><%= p.name %></a></strong>
              </td>
              <td><%= p.category ? p.category.name : 'N/A' %></td>
              <td>
                <code><%= p.sku || 'N/A' %></code>
                <% if (p.hsCode) { %>
                  <br><span style="font-size: 0.75rem; color: #64748b;">HS: <%= p.hsCode %></span>
                <% } %>
              </td>
              <td><%= p.moq ? p.moq.toLocaleString() : '500' %> <%= p.unit || 'pcs' %></td>
              <td>
                <span class="badge <%= p.status === 'PUBLISHED' ? 'badge-published' : 'badge-draft' %>">
                  <%= p.status %>
                </span>
              </td>
              <td>
                <div style="display: flex; gap: 0.5rem;">
                  <button class="btn btn-outline btn-sm" onclick="togglePublish('<%= p.id %>', '<%= p.status === 'PUBLISHED' ? 'unpublish' : 'publish' %>')">
                    <%= p.status === 'PUBLISHED' ? 'Unpublish' : 'Publish' %>
                  </button>
                  <a href="/en-gb/products/<%= p.slug %>" target="_blank" class="btn btn-outline btn-sm">
                    <i data-lucide="external-link"></i>
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 2rem; color: #64748b;">
              No products found in catalogue. Click "Add New Product" to create your first export listing.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Add Product Modal -->
<div id="new-product-modal" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.6); z-index: 1000; align-items: center; justify-content: center; padding: 1.5rem;">
  <div style="background: #ffffff; border-radius: 16px; width: 100%; max-width: 680px; max-height: 90vh; overflow-y: auto; padding: 2rem; position: relative;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid #e2e8f0;">
      <h3>Create New Export Product</h3>
      <button onclick="document.getElementById('new-product-modal').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b;">&times;</button>
    </div>

    <form id="create-product-form">
      <div class="form-group">
        <label class="form-label">Category *</label>
        <select name="categoryId" class="form-control" required>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Product Name *</label>
        <input type="text" name="name" class="form-control" placeholder="e.g. Traditional Hand-woven Jute Rug" required>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label class="form-label">SKU *</label>
          <input type="text" name="sku" class="form-control" placeholder="e.g. JUTE-RUG-001" required>
        </div>
        <div class="form-group">
          <label class="form-label">HS Tariff Code</label>
          <input type="text" name="hsCode" class="form-control" placeholder="e.g. 5702.20.00">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label class="form-label">MOQ *</label>
          <input type="number" name="moq" class="form-control" value="500" required>
        </div>
        <div class="form-group">
          <label class="form-label">Unit *</label>
          <input type="text" name="unit" class="form-control" value="pcs" required>
        </div>
        <div class="form-group">
          <label class="form-label">Lead Time (Days)</label>
          <input type="number" name="leadTimeDays" class="form-control" value="30">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Materials (Comma-separated)</label>
        <input type="text" name="materials" class="form-control" placeholder="e.g. 100% Natural Jute, Cotton Weft">
      </div>

      <div class="form-group">
        <label class="form-label">Certifications (Comma-separated)</label>
        <input type="text" name="certifications" class="form-control" placeholder="e.g. ISO 9001, OEKO-TEX Standard 100">
      </div>

      <div class="form-group">
        <label class="form-label">Short Description</label>
        <textarea name="description" class="form-control" rows="3" placeholder="Export lot specifications and bulk supply terms."></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('new-product-modal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Product</button>
      </div>
    </form>
  </div>
</div>

<script>
async function togglePublish(id, action) {
  try {
    const res = await fetch(`/api/v1/products/${id}/${action}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' }
    });
    if (res.ok) {
      window.location.reload();
    } else {
      alert('Action failed');
    }
  } catch (err) {
    alert('Network error');
  }
}

document.getElementById('create-product-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData.entries());
  if (data.materials) data.materials = data.materials.split(',').map(s => s.trim());
  if (data.certifications) data.certifications = data.certifications.split(',').map(s => s.trim());
  data.moq = parseInt(data.moq) || 500;
  data.leadTimeDays = parseInt(data.leadTimeDays) || 30;

  try {
    const res = await fetch('/api/v1/products', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    if (res.ok) {
      window.location.reload();
    } else {
      const err = await res.json();
      alert('Error creating product: ' + (err.error || 'Server error'));
    }
  } catch (err) {
    alert('Network error');
  }
});
</script>
