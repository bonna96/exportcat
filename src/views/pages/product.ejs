<%- include('../partials/breadcrumbs', { breadcrumbs, locale }) %>

<div class="container" style="padding-bottom: 5rem;">
  <div class="product-detail-grid">
    <!-- Image Gallery -->
    <div class="product-gallery">
      <div class="gallery-main" id="main-product-image-container">
        <% if (product.images && product.images.length > 0) { %>
          <img src="/<%= product.images[0].url %>" alt="<%= product.name %>" id="main-product-image">
        <% } else { %>
          <div class="product-placeholder">
            <i data-lucide="package" style="width: 80px; height: 80px; color: #94a3b8;"></i>
            <span style="font-weight: 600; color: #64748b;">Export Grade Product</span>
          </div>
        <% } %>
      </div>

      <% if (product.images && product.images.length > 1) { %>
        <div class="gallery-thumbs">
          <% product.images.forEach(function(img, idx) { %>
            <div class="gallery-thumb <%= idx === 0 ? 'is-active' : '' %>" onclick="document.getElementById('main-product-image').src='/<%= img.url %>'; document.querySelectorAll('.gallery-thumb').forEach(t=>t.classList.remove('is-active')); this.classList.add('is-active');">
              <img src="/<%= img.url %>" alt="<%= product.name %> thumbnail <%= idx+1 %>">
            </div>
          <% }); %>
        </div>
      <% } %>

      <!-- Supplier Information Card -->
      <% if (product.supplier) { %>
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; margin-top: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
            <i data-lucide="building-2" style="color: #1e3a8a;"></i>
            <h4 style="margin: 0;"><%= product.supplier.name %></h4>
            <span style="background: #ecfdf5; color: #059669; font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 4px;">VERIFIED</span>
          </div>
          <p style="font-size: 0.875rem; color: #64748b; margin-bottom: 0.75rem;">
            Country: <strong><%= product.supplier.country %></strong>
          </p>
          <% if (product.supplier.certifications && product.supplier.certifications.length > 0) { %>
            <div style="display: flex; flex-wrap: wrap; gap: 0.375rem;">
              <% product.supplier.certifications.forEach(function(c) { %>
                <span class="spec-chip" style="background: #eff6ff; color: #1e40af;"><%= c %></span>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Product Details & Actions -->
    <div class="product-info-panel">
      <% if (product.category) { %>
        <a href="/<%= locale %>/categories/<%= product.category.slug %>" style="color: #0284c7; font-weight: 700; font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.05em; display: inline-block; margin-bottom: 0.5rem;">
          <%= product.category.name %>
        </a>
      <% } %>

      <h1><%= product.name %></h1>

      <div class="product-meta-header">
        <span class="meta-item">SKU: <strong><%= product.sku || 'N/A' %></strong></span>
        <span class="meta-item">HS Code: <strong><%= product.hsCode || 'N/A' %></strong></span>
        <span class="meta-item">Origin: <strong><%= product.originCountry || 'Bangladesh' %></strong></span>
      </div>

      <p style="font-size: 1rem; color: #334155; margin-bottom: 1.5rem; line-height: 1.6;">
        <%= product.shortDesc || product.description %>
      </p>

      <!-- Tiered FOB Price Brackets -->
      <div class="pricing-card">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <h3 style="font-size: 1.125rem;"><i data-lucide="tag"></i> Wholesale Tiered Pricing (FOB)</h3>
          <span style="font-size: 0.8125rem; color: #64748b;">Currency: <strong class="active-currency-code">USD</strong></span>
        </div>

        <table class="tiered-table">
          <thead>
            <tr>
              <th>Order Quantity (<%= product.unit || 'pcs' %>)</th>
              <th>Unit Price (FOB)</th>
            </tr>
          </thead>
          <tbody>
            <% if (product.priceBrackets && product.priceBrackets.length > 0) { %>
              <% product.priceBrackets.forEach(function(bracket) { %>
                <tr>
                  <td>
                    <%= bracket.minQty.toLocaleString() %> <%= bracket.maxQty ? '– ' + bracket.maxQty.toLocaleString() : '+ pcs' %>
                  </td>
                  <td>
                    <span data-usd-price="<%= bracket.unitPrice %>">$<%= Number(bracket.unitPrice).toFixed(2) %></span>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td>MOQ <%= product.moq || 500 %>+</td>
                <td><span data-usd-price="12.50">$12.50</span></td>
              </tr>
            <% } %>
          </tbody>
        </table>
        <div style="font-size: 0.8125rem; color: #64748b; margin-top: 0.75rem;">
          * Port of Loading: Chattogram (Chittagong) / Mongla Port, Bangladesh. Custom packaging available.
        </div>
      </div>

      <!-- Specifications Table -->
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem;">
        <h3 style="font-size: 1.125rem; margin-bottom: 0.5rem;"><i data-lucide="file-text"></i> Technical Specifications</h3>
        <table class="specs-table">
          <tbody>
            <% if (product.hsCode) { %>
              <tr>
                <td>HS Tariff Code</td>
                <td><strong><%= product.hsCode %></strong></td>
              </tr>
            <% } %>
            <% if (product.materials && product.materials.length > 0) { %>
              <tr>
                <td>Materials Composition</td>
                <td><%= product.materials.join(', ') %></td>
              </tr>
            <% } %>
            <% if (product.certifications && product.certifications.length > 0) { %>
              <tr>
                <td>Certifications & Standards</td>
                <td><%= product.certifications.join(', ') %></td>
              </tr>
            <% } %>
            <% if (product.leadTimeDays) { %>
              <tr>
                <td>Production Lead Time</td>
                <td><%= product.leadTimeDays %> business days</td>
              </tr>
            <% } %>
            <% if (product.moq) { %>
              <tr>
                <td>Minimum Order (MOQ)</td>
                <td><%= product.moq.toLocaleString() %> <%= product.unit || 'pcs' %></td>
              </tr>
            <% } %>
            <% if (product.weight) { %>
              <tr>
                <td>Unit Net Weight</td>
                <td><%= product.weight %></td>
              </tr>
            <% } %>
            <% if (product.dimensions) { %>
              <tr>
                <td>Unit Dimensions</td>
                <td><%= product.dimensions %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Request For Quote (RFQ) Form -->
      <div class="rfq-card" id="rfq">
        <h3 style="color: #065f46; margin-bottom: 0.5rem;"><i data-lucide="send"></i> Request Wholesale Quotation (RFQ)</h3>
        <p style="font-size: 0.875rem; color: #047857; margin-bottom: 1.25rem;">
          Submit your order specifications directly to the manufacturing export team. Response guaranteed within 24 hours.
        </p>

        <form id="rfq-form">
          <input type="hidden" name="productId" value="<%= product.id %>">
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label">Order Quantity (<%= product.unit || 'pcs' %>) *</label>
              <input type="number" name="quantity" class="form-control" min="<%= product.moq || 1 %>" value="<%= product.moq || 500 %>" required>
            </div>
            <div class="form-group">
              <label class="form-label">Target Incoterms *</label>
              <select name="incoterms" class="form-control">
                <option value="FOB">FOB (Free on Board - Chittagong)</option>
                <option value="CIF">CIF (Cost, Insurance & Freight)</option>
                <option value="CFR">CFR (Cost & Freight)</option>
                <option value="EXW">EXW (Ex Works Factory)</option>
              </select>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label">Destination Port / Country *</label>
              <input type="text" name="destinationPort" class="form-control" placeholder="e.g., Port of Hamburg / Rotterdam" required>
            </div>
            <div class="form-group">
              <label class="form-label">Target Unit Price (USD)</label>
              <input type="number" step="0.01" name="targetPrice" class="form-control" placeholder="Optional budget limit">
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label">Your Name *</label>
              <input type="text" name="buyerName" class="form-control" value="<%= user ? user.name : '' %>" required>
            </div>
            <div class="form-group">
              <label class="form-label">Corporate Email *</label>
              <input type="email" name="buyerEmail" class="form-control" value="<%= user ? user.email : '' %>" required>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Company / Importer Name *</label>
            <input type="text" name="buyerCompany" class="form-control" placeholder="Your registered trading entity" required>
          </div>

          <div class="form-group">
            <label class="form-label">Special Specifications / Packaging Instructions</label>
            <textarea name="notes" class="form-control" rows="3" placeholder="Provide requirements for private labeling, customized master cartons, palletization, or specific lab tests."></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">
            <i data-lucide="check-circle"></i> Submit RFQ Direct to Exporter
          </button>
        </form>

        <div id="rfq-feedback" style="display: none; margin-top: 1rem; padding: 1rem; border-radius: 8px;"></div>
      </div>
    </div>
  </div>

  <!-- Related Products -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
    <div style="margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid #e2e8f0;">
      <h2 style="margin-bottom: 1.5rem;">Related Export Lots</h2>
      <div class="products-grid">
        <% relatedProducts.forEach(function(rProd) { %>
          <article class="product-card">
            <div class="product-thumb">
              <% if (rProd.images && rProd.images.length > 0) { %>
                <img src="/<%= rProd.images[0].url %>" alt="<%= rProd.name %>">
              <% } else { %>
                <div class="product-placeholder">
                  <i data-lucide="package" style="width: 48px; height: 48px;"></i>
                </div>
              <% } %>
            </div>
            <div class="product-body">
              <h3 class="product-title">
                <a href="/<%= locale %>/products/<%= rProd.slug %>"><%= rProd.name %></a>
              </h3>
              <div class="product-pricing">
                <div class="price-box">
                  <span class="price-label">FOB Price</span>
                  <% const p = rProd.priceBrackets && rProd.priceBrackets.length > 0 ? rProd.priceBrackets[0].unitPrice : 10.0; %>
                  <span class="price-value" data-usd-price="<%= p %>">$<%= Number(p).toFixed(2) %></span>
                </div>
                <div class="moq-tag">
                  MOQ: <%= rProd.moq ? rProd.moq.toLocaleString() : '500' %>
                </div>
              </div>
            </div>
            <div class="product-actions">
              <a href="/<%= locale %>/products/<%= rProd.slug %>" class="btn btn-outline btn-sm">
                View Details
              </a>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const rfqForm = document.getElementById('rfq-form');
  const feedback = document.getElementById('rfq-feedback');

  if (rfqForm) {
    rfqForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(rfqForm);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/v1/enquiries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (res.ok) {
          feedback.style.display = 'block';
          feedback.style.background = '#ecfdf5';
          feedback.style.color = '#065f46';
          feedback.style.border = '1px solid #a7f3d0';
          feedback.innerHTML = '<strong>RFQ Submitted Successfully!</strong> Reference #' + (result.enquiry ? result.enquiry.id : 'OK') + '. The exporter and catalogue manager have been notified.';
          rfqForm.reset();
        } else {
          feedback.style.display = 'block';
          feedback.style.background = '#fef2f2';
          feedback.style.color = '#991b1b';
          feedback.style.border = '1px solid #fecaca';
          feedback.innerHTML = '<strong>Submission Error:</strong> ' + (result.error || 'Failed to submit enquiry.');
        }
      } catch (err) {
        feedback.style.display = 'block';
        feedback.style.background = '#fef2f2';
        feedback.style.color = '#991b1b';
        feedback.innerHTML = 'Network error submitting RFQ. Please check connection.';
      }
    });
  }
});
</script>
