<div class="container" style="padding-top: 2rem; padding-bottom: 5rem;">
  <div style="margin-bottom: 2rem;">
    <h1>Product Specification Comparison</h1>
    <p style="margin-top: 0.5rem; font-size: 1.0625rem;">
      Side-by-side evaluation of export specifications, MOQ, lead times, and FOB price tiers.
    </p>
  </div>

  <% if (products && products.length > 0) { %>
    <div class="compare-container">
      <table class="compare-table">
        <tbody>
          <!-- Image & Name -->
          <tr>
            <th>Product</th>
            <% products.forEach(function(p) { %>
              <td style="min-width: 240px;">
                <div style="aspect-ratio: 4/3; background: #f1f5f9; border-radius: 8px; overflow: hidden; margin-bottom: 0.75rem;">
                  <% if (p.images && p.images.length > 0) { %>
                    <img src="/<%= p.images[0].url %>" alt="<%= p.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                  <% } else { %>
                    <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #94a3b8;">
                      <i data-lucide="package" style="width: 40px; height: 40px;"></i>
                    </div>
                  <% } %>
                </div>
                <h4 style="font-size: 1rem; margin-bottom: 0.5rem;">
                  <a href="/<%= locale %>/products/<%= p.slug %>" style="color: #1e3a8a;"><%= p.name %></a>
                </h4>
                <a href="/<%= locale %>/products/<%= p.slug %>#rfq" class="btn btn-primary btn-sm" style="width: 100%;">
                  Request RFQ
                </a>
              </td>
            <% }); %>
          </tr>

          <!-- Category -->
          <tr>
            <th>Category</th>
            <% products.forEach(function(p) { %>
              <td><%= p.category ? p.category.name : 'N/A' %></td>
            <% }); %>
          </tr>

          <!-- MOQ -->
          <tr>
            <th>Minimum Order (MOQ)</th>
            <% products.forEach(function(p) { %>
              <td><strong><%= p.moq ? p.moq.toLocaleString() : '500' %> <%= p.unit || 'pcs' %></strong></td>
            <% }); %>
          </tr>

          <!-- FOB Price Tier -->
          <tr>
            <th>FOB Base Price</th>
            <% products.forEach(function(p) { %>
              <td>
                <% const pr = p.priceBrackets && p.priceBrackets.length > 0 ? p.priceBrackets[0].unitPrice : 15.0; %>
                <span class="price-value" data-usd-price="<%= pr %>" style="font-size: 1.125rem; font-weight: 700; color: #1e3a8a;">
                  $<%= Number(pr).toFixed(2) %>
                </span> / <%= p.unit || 'pc' %>
              </td>
            <% }); %>
          </tr>

          <!-- Lead Time -->
          <tr>
            <th>Lead Time</th>
            <% products.forEach(function(p) { %>
              <td><%= p.leadTimeDays ? p.leadTimeDays + ' business days' : '30 business days' %></td>
            <% }); %>
          </tr>

          <!-- Materials -->
          <tr>
            <th>Materials</th>
            <% products.forEach(function(p) { %>
              <td><%= p.materials && p.materials.length > 0 ? p.materials.join(', ') : 'Standard export grade' %></td>
            <% }); %>
          </tr>

          <!-- Certifications -->
          <tr>
            <th>Certifications</th>
            <% products.forEach(function(p) { %>
              <td>
                <% if (p.certifications && p.certifications.length > 0) { %>
                  <div style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
                    <% p.certifications.forEach(function(c) { %>
                      <span class="spec-chip" style="background: #eff6ff; color: #1e40af;"><%= c %></span>
                    <% }); %>
                  </div>
                <% } else { %>
                  <span style="color: #94a3b8;">Standard Factory QC</span>
                <% } %>
              </td>
            <% }); %>
          </tr>

          <!-- Origin Country -->
          <tr>
            <th>Origin Country</th>
            <% products.forEach(function(p) { %>
              <td><%= p.originCountry || 'Bangladesh' %></td>
            <% }); %>
          </tr>

          <!-- Supplier -->
          <tr>
            <th>Manufacturer / Supplier</th>
            <% products.forEach(function(p) { %>
              <td>
                <strong><%= p.supplier ? p.supplier.name : 'Verified Mill' %></strong>
              </td>
            <% }); %>
          </tr>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 4rem 2rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;">
      <i data-lucide="columns" style="width: 56px; height: 56px; color: #94a3b8; margin: 0 auto 1rem;"></i>
      <h3>No products selected for comparison</h3>
      <p style="margin-top: 0.5rem; margin-bottom: 1.5rem; max-width: 500px; margin-left: auto; margin-right: auto;">
        Select products across categories or use the quick comparison links below to compare export specifications.
      </p>
      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/<%= locale %>/compare?products=natural-raw-hessian-jute-fabric-burlap,heavy-duty-jute-sacking-bags" class="btn btn-outline btn-sm">
          Compare Jute Products
        </a>
        <a href="/<%= locale %>/compare?products=organic-combed-cotton-single-jersey,denim-fabric-heavyweight-twill" class="btn btn-outline btn-sm">
          Compare Textiles
        </a>
        <a href="/<%= locale %>/search" class="btn btn-primary btn-sm">
          Browse Catalogue
        </a>
      </div>
    </div>
  <% } %>
</div>
