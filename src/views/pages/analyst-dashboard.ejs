<div class="container" style="padding-top: 2.5rem; padding-bottom: 5rem;">
  <div class="dashboard-header">
    <div>
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <h1>Search & SEO Analyst Dashboard</h1>
        <span class="role-tag role-ANALYST">ANALYST PORTAL</span>
      </div>
      <p style="margin-top: 0.25rem;">
        Information Retrieval (IR) evaluation metrics, BM25 vs TF-IDF benchmarking, PageRank graph crawler, and synonym rules.
      </p>
    </div>
    <div style="display: flex; gap: 0.75rem;">
      <button class="btn btn-primary btn-sm" id="btn-run-ir">
        <i data-lucide="play"></i> Run IR Evaluation
      </button>
      <button class="btn btn-outline btn-sm" id="btn-run-pagerank">
        <i data-lucide="network"></i> PageRank Audit
      </button>
      <a href="/logout" class="btn btn-outline btn-sm">
        <i data-lucide="log-out"></i> Sign Out
      </a>
    </div>
  </div>

  <!-- Search KPIs -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-card-title">TOTAL QUERIES LOGGED</div>
      <div class="stat-card-value"><%= totalSearches || 0 %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card-title">ZERO-RESULT QUERIES</div>
      <div class="stat-card-value" style="color: <%= zeroResults > 0 ? '#dc2626' : '#059669' %>;"><%= zeroResults || 0 %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card-title">SEARCH ENGINE SCORING</div>
      <div class="stat-card-value" style="color: #2563eb; font-size: 1.5rem;">BM25 (k1=1.5, b=0.75)</div>
    </div>
    <div class="stat-card">
      <div class="stat-card-title">ACTIVE SYNONYM EXPANSIONS</div>
      <div class="stat-card-value" style="color: #0284c7;"><%= synonyms ? synonyms.length : 0 %></div>
    </div>
  </div>

  <!-- IR Academic Evaluation Results Section (Dynamic) -->
  <div class="data-table-wrap" id="ir-eval-section" style="margin-bottom: 2.5rem; display: none;">
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #e2e8f0; background: #f8fafc; display: flex; align-items: center; justify-content: space-between;">
      <div>
        <h3 style="margin-bottom: 0.25rem;"><i data-lucide="award"></i> Academic Information Retrieval (IR) Evaluation</h3>
        <p style="font-size: 0.8125rem; color: #64748b; margin: 0;">
          Comparative benchmark: Okapi BM25 vs Vector Space TF-IDF vs Exact Boolean.
        </p>
      </div>
      <span class="badge" style="background: #eff6ff; color: #1e40af;">IR & SEO COURSE (22CSE006)</span>
    </div>
    <div id="ir-eval-content" style="padding: 1.5rem;">
      <p style="color: #64748b;">Computing evaluation metrics against TREC QRELS ground truth...</p>
    </div>
  </div>

  <!-- PageRank Graph Results Section (Dynamic) -->
  <div class="data-table-wrap" id="pagerank-section" style="margin-bottom: 2.5rem; display: none;">
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
      <h3 style="margin-bottom: 0.25rem;"><i data-lucide="network"></i> PageRank Link Graph & Crawl Audit</h3>
      <p style="font-size: 0.8125rem; color: #64748b; margin: 0;">Power iteration algorithm with damping factor &alpha; = 0.85.</p>
    </div>
    <div id="pagerank-content" style="padding: 1.5rem;">
      <p style="color: #64748b;">Crawling catalogue URLs...</p>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
    <!-- Recent Search Queries -->
    <div class="data-table-wrap">
      <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #e2e8f0;">
        <h3>Recent Search Queries</h3>
      </div>
      <table class="data-table">
        <thead>
          <tr>
            <th>Query</th>
            <th>Results</th>
            <th>Latency</th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentSearches && recentSearches.length > 0) { %>
            <% recentSearches.forEach(function(s) { %>
              <tr>
                <td><strong><%= s.queryText %></strong></td>
                <td>
                  <span class="badge <%= s.resultCount === 0 ? 'badge-draft' : 'badge-published' %>">
                    <%= s.resultCount %>
                  </span>
                </td>
                <td><%= s.tookMs || 12 %>ms</td>
                <td style="color: #94a3b8; font-size: 0.75rem;"><%= new Date(s.createdAt).toLocaleTimeString() %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="4" style="text-align: center; color: #94a3b8; padding: 2rem;">No search queries recorded yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Synonym Rules Management -->
    <div class="data-table-wrap">
      <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
        <h3>Synonym Rules</h3>
        <button class="btn btn-outline btn-sm" onclick="document.getElementById('add-synonym-form').style.display='block'">
          <i data-lucide="plus"></i> Add Rule
        </button>
      </div>

      <div id="add-synonym-form" style="display: none; padding: 1.25rem 1.5rem; background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
        <form id="create-synonym-form">
          <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 0.75rem; margin-bottom: 0.75rem;">
            <input type="text" name="sourceTerm" class="form-control" placeholder="Source term (e.g. jute)" required>
            <input type="text" name="targetTerms" class="form-control" placeholder="Synonyms (e.g. hessian, burlap)" required>
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
            <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('add-synonym-form').style.display='none'">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Save Synonym</button>
          </div>
        </form>
      </div>

      <table class="data-table">
        <thead>
          <tr>
            <th>Source Term</th>
            <th>Expanded Synonyms</th>
            <th>Type</th>
          </tr>
        </thead>
        <tbody>
          <% if (synonyms && synonyms.length > 0) { %>
            <% synonyms.forEach(function(syn) { %>
              <tr>
                <td><strong><%= syn.sourceTerm %></strong></td>
                <td><%= Array.isArray(syn.targetTerms) ? syn.targetTerms.join(', ') : syn.targetTerms %></td>
                <td><span class="badge badge-published"><%= syn.ruleType || 'ONE_WAY' %></span></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="3" style="text-align: center; color: #94a3b8; padding: 2rem;">No synonym rules configured.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
document.getElementById('btn-run-ir').addEventListener('click', async () => {
  const section = document.getElementById('ir-eval-section');
  const container = document.getElementById('ir-eval-content');
  section.style.display = 'block';
  container.innerHTML = '<p style="color: #64748b;">Running Python IR evaluation suite (evaluating Precision@k, Recall@k, MAP, MRR, NDCG@k)...</p>';

  try {
    const res = await fetch('/api/v1/analytics/ir-evaluation');
    const data = await res.json();
    if (data.models) {
      let html = `
        <table class="tiered-table" style="margin-top: 0;">
          <thead>
            <tr>
              <th>Ranking Model</th>
              <th>Mean P@5</th>
              <th>Mean P@10</th>
              <th>Mean Recall@10</th>
              <th>MAP (Mean Avg Prec)</th>
              <th>MRR</th>
              <th>NDCG@10</th>
            </tr>
          </thead>
          <tbody>
      `;
      for (const [key, m] of Object.entries(data.models)) {
        const isBm25 = key === 'bm25';
        html += `
          <tr style="${isBm25 ? 'background: #eff6ff; font-weight: 600;' : ''}">
            <td><strong>${m.model_name} ${isBm25 ? '⭐ (Default)' : ''}</strong></td>
            <td>${m.mean_p5}</td>
            <td>${m.mean_p10}</td>
            <td>${m.mean_r10}</td>
            <td style="color: #059669; font-weight: 700;">${m.map}</td>
            <td>${m.mrr}</td>
            <td style="color: #2563eb; font-weight: 700;">${m.mean_ndcg10}</td>
          </tr>
        `;
      }
      html += `
          </tbody>
        </table>
        <div style="font-size: 0.8125rem; color: #64748b; margin-top: 1rem;">
          * Evaluated across ${data.models.bm25.queries_evaluated} domain queries against TREC-standard ground truth judgements. BM25 shows superior Mean Average Precision and NDCG ranking.
        </div>
      `;
      container.innerHTML = html;
    } else {
      container.innerHTML = '<p style="color: #dc2626;">Error running evaluation: ' + (data.error || 'Unknown error') + '</p>';
    }
  } catch (err) {
    container.innerHTML = '<p style="color: #dc2626;">Failed to connect to evaluation runner.</p>';
  }
});

document.getElementById('btn-run-pagerank').addEventListener('click', async () => {
  const section = document.getElementById('pagerank-section');
  const container = document.getElementById('pagerank-content');
  section.style.display = 'block';
  container.innerHTML = '<p style="color: #64748b;">Running PageRank power-iteration crawler...</p>';

  try {
    const res = await fetch('/api/v1/analytics/crawl-audit');
    const data = await res.json();
    if (data.pages) {
      let html = `
        <div style="display: flex; gap: 2rem; margin-bottom: 1.5rem;">
          <div>Total Pages: <strong>${data.summary.total_pages_crawled}</strong></div>
          <div>Internal Link Edges: <strong>${data.summary.internal_edges}</strong></div>
          <div>Broken Links (404): <strong style="color: #059669;">${data.summary.broken_links_count}</strong></div>
        </div>
        <table class="tiered-table" style="margin-top: 0;">
          <thead>
            <tr>
              <th>Rank</th>
              <th>Page URL</th>
              <th>PageRank Score</th>
              <th>In-Links</th>
              <th>Out-Links</th>
              <th>Depth</th>
            </tr>
          </thead>
          <tbody>
      `;
      data.pages.slice(0, 8).forEach(p => {
        html += `
          <tr>
            <td>#${p.rank}</td>
            <td><code>${p.url}</code></td>
            <td style="font-weight: 700; color: #1e3a8a;">${p.pagerank.toFixed(5)}</td>
            <td>${p.in_degree}</td>
            <td>${p.out_degree}</td>
            <td>${p.crawl_depth}</td>
          </tr>
        `;
      });
      html += '</tbody></table>';
      container.innerHTML = html;
    } else {
      container.innerHTML = '<p style="color: #dc2626;">Error: ' + (data.error || 'Audit failed') + '</p>';
    }
  } catch (err) {
    container.innerHTML = '<p style="color: #dc2626;">Failed to connect to PageRank crawler.</p>';
  }
});

document.getElementById('create-synonym-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData.entries());
  data.targetTerms = data.targetTerms.split(',').map(s => s.trim());

  try {
    const res = await fetch('/api/v1/synonyms', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    if (res.ok) {
      window.location.reload();
    } else {
      alert('Error creating synonym rule');
    }
  } catch (err) {
    alert('Network error');
  }
});
</script>
