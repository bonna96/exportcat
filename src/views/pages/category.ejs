<%- include('../partials/breadcrumbs', { breadcrumbs, locale }) %>

<div class="container" style="padding-bottom: 4rem;">
  <div style="margin-bottom: 2rem;">
    <h1><%= category.name %></h1>
    <p style="font-size: 1.0625rem; max-width: 800px; margin-top: 0.5rem;">
      <%= category.description || 'Export grade manufactured lots and bulk supplies directly from Bangladesh.' %>
    </p>
  </div>

  <div class="catalog-layout">
    <!-- Facet Sidebar -->
    <%- include('../partials/facet-sidebar', { facets, query, locale, category }) %>

    <!-- Products Content -->
    <section>
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; background: #ffffff; padding: 1rem 1.25rem; border: 1px solid #e2e8f0; border-radius: 8px;">
        <div style="font-size: 0.9375rem; color: #64748b;">
          Showing <strong><%= products ? products.length : 0 %></strong> of <strong><%= total || 0 %></strong> export products
        </div>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <a href="/<%= locale %>/compare" class="btn btn-outline btn-sm">
            <i data-lucide="columns"></i> Product Comparison
          </a>
        </div>
      </div>

      <% if (products && products.length > 0) { %>
        <div class="products-grid">
          <% products.forEach(function(prod) { %>
            <article class="product-card">
              <div class="product-thumb">
                <% if (prod.images && prod.images.length > 0) { %>
                  <% const imgSrc = prod.images[0].webpUrl || prod.images[0].originalUrl || prod.images[0].url; %>
                  <img src="<%= imgSrc.startsWith('/') ? imgSrc : '/' + imgSrc %>" alt="<%= prod.name %>" loading="lazy">
                <% } else { %>
                  <div class="product-placeholder">
                    <i data-lucide="package" style="width: 48px; height: 48px;"></i>
                    <span>Export Product</span>
                  </div>
                <% } %>
                <span class="product-badge-origin"><%= prod.originCountry || 'Bangladesh' %></span>
              </div>
              
              <div class="product-body">
                <div class="product-category-name"><%= category.name %></div>
                <h3 class="product-title">
                  <a href="/<%= locale %>/products/<%= prod.slug %>"><%= prod.name %></a>
                </h3>
                
                <div class="product-specs">
                  <% if (prod.materials && prod.materials.length > 0) { %>
                    <span class="spec-chip"><%= prod.materials[0] %></span>
                  <% } %>
                  <% if (prod.certifications && prod.certifications.length > 0) { %>
                    <span class="spec-chip"><%= prod.certifications[0] %></span>
                  <% } %>
                </div>

                <div class="product-pricing">
                  <div class="price-box">
                    <span class="price-label">FOB Price</span>
                    <% const basePrice = prod.priceBrackets && prod.priceBrackets.length > 0 ? (prod.priceBrackets[0].priceUsd || prod.priceBrackets[0].unitPrice || 10.0) : 10.0; %>
                    <span class="price-value" data-usd-price="<%= basePrice %>">$<%= Number(basePrice).toFixed(2) %></span>
                    <span style="font-size: 0.75rem; color: #64748b;">/ <%= prod.unit || 'pc' %></span>
                  </div>
                  <div class="moq-tag">
                    MOQ: <%= prod.moq ? prod.moq.toLocaleString() : '500' %>
                  </div>
                </div>
              </div>

              <div class="product-actions">
                <a href="/<%= locale %>/products/<%= prod.slug %>" class="btn btn-outline btn-sm">
                  <i data-lucide="eye"></i> Details
                </a>
                <a href="/<%= locale %>/products/<%= prod.slug %>#rfq" class="btn btn-primary btn-sm">
                  <i data-lucide="send"></i> RFQ
                </a>
              </div>
            </article>
          <% }); %>
        </div>

        <!-- Pagination -->
        <% if (totalPages && totalPages > 1) { %>
          <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 2rem;">
            <% for (let p = 1; p <= totalPages; p++) { %>
              <a href="?page=<%= p %>" class="btn <%= p === page ? 'btn-primary' : 'btn-outline' %> btn-sm">
                <%= p %>
              </a>
            <% } %>
          </div>
        <% } %>

      <% } else { %>
        <div style="text-align: center; padding: 4rem 2rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;">
          <i data-lucide="inbox" style="width: 48px; height: 48px; color: #94a3b8; margin: 0 auto 1rem;"></i>
          <h3>No matching products found</h3>
          <p style="margin-top: 0.5rem; margin-bottom: 1.5rem;">Try relaxing your filter criteria or searching with broader terms.</p>
          <a href="/<%= locale %>/categories/<%= category.slug %>" class="btn btn-outline btn-sm">Clear Filters</a>
        </div>
      <% } %>
    </section>
  </div>
</div>
